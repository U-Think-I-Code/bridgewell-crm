# ============================================================================
# Bridgewell CRM — Environment Variables Template
# Copy this file to .env.local and fill in your production credentials
# ============================================================================

# Supabase Database & Auth (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Meta Ads Webhook Integration (Optional / Production)
META_VERIFY_TOKEN=your-webhook-verify-token
META_APP_SECRET=your-meta-app-secret
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token
NEXT_PUBLIC_META_VERIFY_TOKEN=your-webhook-verify-token

# Security & Encryption (Optional)
DATA_ENCRYPTION_KEY=your-32-byte-aes-encryption-key
